# Example environment variables for VEXORA (DO NOT COMMIT real secrets)

# Discord bot token (keep secret!)
DISCORD_TOKEN=your_bot_token_here

# Discord application (client) ID
CLIENT_ID=your_client_id_here

# A test guild (server) ID for registering guild commands
GUILD_ID=your_guild_id_here

# Demo/testing secret (not a real security key) — for local demo only
# The demo accepts numeric keys 1-10 as temporary test keys
DEMO_SECRET=demo-1-10-only

# Optional: SECRET_KEY for session signing in production
SECRET_KEY=replace_with_secure_random_value
